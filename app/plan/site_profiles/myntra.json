{
    "name": "myntra",
    "search_url": "https://www.myntra.com/{query}",
    "pagination_url": "https://www.myntra.com/{query}?p={page}",
    "max_pages": 1,
    "min_items_per_page": 5,
    "pagination_type": "button",
    "price_filter_support": true,
    "wait_selectors": [".product-base"],
    "card": ".product-base",
    "title": ".product-brand, .product-product",
    "price": ".product-discountedPrice",
    "rating": ".product-rating",
    "url": ".product-base a",
    "next_button": ".pagination-next",
    "item_timeout": 10000,
    "page_timeout": 30000
}