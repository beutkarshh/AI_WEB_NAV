{
  "name": "myntra",
  "search_url": "https://www.myntra.com/search?q={query}&sort=relevance",
  "wait_selectors": [".search-searchProductsContainer", ".product-base"],
  "card": ".product-base, li[class*='product-base']",

  "sel_title": ".product-product, .product-brand, h3, h4, .product-productMetaInfo h3",
  "sel_link": "a",
  "sel_price": ".product-discountedPrice, .product-price, .price-price", 
  "sel_price_alt": ".product-strike, .price-mrp",
  "sel_rating": ".product-ratingsContainer span, .ratings-rating",

  "sort": "relevance",
  "page_budget": 1,
  "max_cards": 24
}
